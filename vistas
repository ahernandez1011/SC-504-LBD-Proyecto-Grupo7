--CREACION VISTAS
--ver lista clientes registrados
CREATE OR REPLACE VIEW V_CLIENTES AS
SELECT 
  CLIENTE_ID,
  NOMBRE,
  TELEFONO,
  CORREO
FROM CLIENTES;

--ver personal del restaurante
CREATE OR REPLACE VIEW V_EMPLEADOS AS
SELECT 
  EMPLEADO_ID,
  NOMBRE,
  ROL,
  USUARIO
FROM EMPLEADOS;

--ver productos del menu
CREATE OR REPLACE VIEW V_PRODUCTOS AS
SELECT 
  PRODUCTO_ID,
  NOMBRE,
  TIPO,
  PRECIO,
  ACTIVO
FROM PRODUCTOS;

--ver inventario relacionado a productos
CREATE OR REPLACE VIEW V_INVENTARIO_PRODUCTO AS
SELECT 
  I.INVENTARIO_ID,
  I.EXISTENCIAS,
  I.STOCK_MINIMO,
  P.NOMBRE AS PRODUCTO
FROM INVENTARIO I, PRODUCTOS P
WHERE I.PRODUCTO_ID = P.PRODUCTO_ID;

--ver pedidos
CREATE OR REPLACE VIEW V_PEDIDOS AS
SELECT 
  PEDIDO_ID,
  CLIENTE_ID,
  EMPLEADO_ID,
  FECHA,
  ESTADO,
  TIPO_SERVICIO
FROM PEDIDOS;

--ver pedidos con cliente correspondiente
CREATE OR REPLACE VIEW V_DETALLE_PEDIDO AS
SELECT 
  DP.DETALLE_ID,
  DP.PEDIDO_ID,
  C.NOMBRE AS CLIENTE,
  P.NOMBRE AS PRODUCTO,
  DP.CANTIDAD,
  DP.SUBTOTAL
FROM DETALLE_PEDIDO DP, PRODUCTOS P, PEDIDOS PE, CLIENTES C
WHERE DP.PRODUCTO_ID = P.PRODUCTO_ID
AND DP.PEDIDO_ID = PE.PEDIDO_ID
AND PE.CLIENTE_ID = C.CLIENTE_ID;

--ver factura con el cliente
CREATE OR REPLACE VIEW V_FACTURAS AS
SELECT 
  F.FACTURA_ID,
  F.PEDIDO_ID,
  C.NOMBRE AS CLIENTE,
  F.FECHA,
  F.TOTAL,
  F.DESCUENTO_APLICADO
FROM FACTURAS F, PEDIDOS P, CLIENTES C
WHERE F.PEDIDO_ID = P.PEDIDO_ID
AND P.CLIENTE_ID = C.CLIENTE_ID;

--ver el pedido con el cliente/empleado
CREATE OR REPLACE VIEW V_PEDIDOS_CLIENTE_EMPLEADO AS
SELECT 
  P.PEDIDO_ID,
  C.NOMBRE AS CLIENTE,
  E.NOMBRE AS EMPLEADO,
  P.FECHA,
  P.ESTADO,
  P.TIPO_SERVICIO
FROM PEDIDOS P, CLIENTES C, EMPLEADOS E
WHERE P.CLIENTE_ID = C.CLIENTE_ID
AND P.EMPLEADO_ID = E.EMPLEADO_ID;


--ver resumen de reportes
CREATE OR REPLACE VIEW V_REPORTES AS
SELECT 
  REPORTE_ID,
  FECHA_INICIO,
  FECHA_FIN,
  VENTAS_TOTALES
FROM REPORTES;

--ver reporte general
CREATE OR REPLACE VIEW V_REPORTE_GENERAL AS
SELECT 
  R.REPORTE_ID,
  R.FECHA_INICIO,
  R.FECHA_FIN,
  R.VENTAS_TOTALES,
  F.FACTURA_ID,
  F.TOTAL AS TOTAL_FACTURA,
  P.PEDIDO_ID,
  P.TIPO_SERVICIO,
  E.NOMBRE AS EMPLEADO,
  C.NOMBRE AS CLIENTE
FROM REPORTES R,
     FACTURAS F,
     PEDIDOS P,
     EMPLEADOS E,
     CLIENTES C
WHERE R.FACTURA_ID = F.FACTURA_ID
AND F.PEDIDO_ID = P.PEDIDO_ID
AND P.EMPLEADO_ID = E.EMPLEADO_ID
AND P.CLIENTE_ID = C.CLIENTE_ID;










