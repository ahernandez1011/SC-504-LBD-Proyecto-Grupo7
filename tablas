--Creacion tabla CLIENTE
CREATE TABLE CLIENTES (
  CLIENTE_ID NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  NOMBRE VARCHAR2(100),
  TELEFONO VARCHAR2(20),
  CORREO VARCHAR2(100)
);

--Creacion tabla EMPLEADOS
CREATE TABLE EMPLEADOS (
  EMPLEADO_ID NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  NOMBRE VARCHAR2(100),
  ROL VARCHAR2(50),
  USUARIO VARCHAR2(50),
  CONTRASENA VARCHAR2(50)
);

--Creacion tabla PRODUCTOS
CREATE TABLE PRODUCTOS (
  PRODUCTO_ID NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  NOMBRE VARCHAR2(100),
  TIPO VARCHAR2(50),
  PRECIO NUMBER,
  DESCRIPCION VARCHAR2(200),
  ACTIVO VARCHAR2(5)
);

--Creacion tabla iNVENTARIO
CREATE TABLE INVENTARIO (
  INVENTARIO_ID NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  PRODUCTO_ID NUMBER,
  EXISTENCIAS NUMBER,
  STOCK_MINIMO NUMBER,
  CONSTRAINT FK_INV_PRODUCTO FOREIGN KEY (PRODUCTO_ID)
    REFERENCES PRODUCTOS (PRODUCTO_ID)
);

--Creacion tabla PEDIDOS
CREATE TABLE PEDIDOS (
  PEDIDO_ID NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  CLIENTE_ID NUMBER,
  EMPLEADO_ID NUMBER,
  FECHA DATE,
  ESTADO VARCHAR2(50),
  TIPO_SERVICIO VARCHAR2(50),
  CONSTRAINT FK_PED_CLIENTE FOREIGN KEY (CLIENTE_ID)
    REFERENCES CLIENTES (CLIENTE_ID),
  CONSTRAINT FK_PED_EMPLEADO FOREIGN KEY (EMPLEADO_ID)
    REFERENCES EMPLEADOS (EMPLEADO_ID)
);

--Creacion tabla DETALLE_PEDIDO
CREATE TABLE DETALLE_PEDIDO (
  DETALLE_ID NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  PEDIDO_ID NUMBER,
  PRODUCTO_ID NUMBER,
  CANTIDAD NUMBER,
  SUBTOTAL NUMBER,
  CONSTRAINT FK_DET_PEDIDO FOREIGN KEY (PEDIDO_ID)
    REFERENCES PEDIDOS (PEDIDO_ID),
  CONSTRAINT FK_DET_PRODUCTO FOREIGN KEY (PRODUCTO_ID)
    REFERENCES PRODUCTOS (PRODUCTO_ID)
);

--Creacion tabla FACTURAS
CREATE TABLE FACTURAS (
  FACTURA_ID NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  PEDIDO_ID NUMBER,
  FECHA DATE,
  TOTAL NUMBER,
  DESCUENTO_APLICADO NUMBER,
  CONSTRAINT FK_FAC_PEDIDO FOREIGN KEY (PEDIDO_ID)
    REFERENCES PEDIDOS (PEDIDO_ID)
);

--Creacion tabla REPORTES
CREATE TABLE REPORTES (
  REPORTE_ID NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  FACTURA_ID NUMBER,
  PRODUCTO_ID NUMBER,
  PEDIDO_ID NUMBER,
  FECHA_INICIO DATE,
  FECHA_FIN DATE,
  VENTAS_TOTALES NUMBER,
  PRODUCTOS_MAS_VENDIDOS VARCHAR2(200),
  PRODUCTOS_MENOS_VENDIDOS VARCHAR2(200),
  CONSTRAINT FK_REP_FACTURA FOREIGN KEY (FACTURA_ID)
    REFERENCES FACTURAS (FACTURA_ID),
  CONSTRAINT FK_REP_PRODUCTO FOREIGN KEY (PRODUCTO_ID)
    REFERENCES PRODUCTOS (PRODUCTO_ID),
  CONSTRAINT FK_REP_PEDIDO FOREIGN KEY (PEDIDO_ID)
    REFERENCES PEDIDOS (PEDIDO_ID)
);

